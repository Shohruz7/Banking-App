# Copy to .env for local development. Every value here is a safe local default —
# real secrets live only in the environment, never in git (ADR-0004).
DJANGO_SECRET_KEY=change-me-in-real-environments
DATABASE_URL=postgres://banking:banking@localhost:5432/banking
REDIS_URL=redis://localhost:6379/0

# Where DRF keeps rate-limit state (ADR-0015). The local-memory default is per-process, which is
# fine for one dev server but silently multiplies every limit by the worker count in production —
# prod.py has no fallback and refuses to boot without this set. Uncomment to exercise the shared
# path locally against the Redis in docker-compose.
# CACHE_URL=rediscache://localhost:6379/1
