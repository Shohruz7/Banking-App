# Copy to .env for local development. Every value here is a safe local default —
# real secrets live only in the environment, never in git (ADR-0004).
DJANGO_SECRET_KEY=change-me-in-real-environments
DATABASE_URL=postgres://banking:banking@localhost:5432/banking
REDIS_URL=redis://localhost:6379/0

# Where DRF keeps rate-limit state (ADR-0015). The local-memory default is per-process, which is
# fine for one dev server but silently multiplies every limit by the worker count in production —
# prod.py has no fallback and refuses to boot without this set. Uncomment to exercise the shared
# path locally against the Redis in docker-compose.
# CACHE_URL=rediscache://localhost:6379/1

# Celery broker (ADR-0019) and the Channels layer (ADR-0022). Both default to the REDIS_URL host on
# their own logical database — /1 and /2 — so a `celery purge` cannot take out live sockets and a
# FLUSHDB during an incident has one blast radius rather than three. Set these only to point them
# at a different server.
# CELERY_BROKER_URL=redis://localhost:6379/1
# CHANNEL_LAYER_URL=redis://localhost:6379/2

# ── Required in production ─────────────────────────────────────────────────────────────────────
# prod.py refuses to boot without each of these. They have no defaults on purpose: booting with a
# placeholder is worse than not booting, because the system then *looks* configured.
#
# DJANGO_ALLOWED_HOSTS is also the WebSocket's CSRF defence — config/asgi.py wraps the router in
# AllowedHostsOriginValidator, so an origin missing here is refused before the socket opens.
# DJANGO_ALLOWED_HOSTS=bank.example.com,www.bank.example.com
#
# Key encryption keys for the envelope-encrypted columns (ADR-0027): the TOTP secret and the account
# number. Comma-separated `label:base64key` pairs, newest first — the first encrypts new writes and
# every listed key can still decrypt what it wrote, which is what makes rotation a rolling change
# rather than a flag day. Generate one with:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# FIELD_ENCRYPTION_KEYS=2026a:REPLACE_ME_32_BYTES_BASE64=,2025a:PREVIOUS_KEY_BASE64=
#
# Origins allowed to post cross-site. Empty until Week 9's SPA has a URL.
# CSRF_TRUSTED_ORIGINS=https://bank.example.com

# ── Optional tuning ────────────────────────────────────────────────────────────────────────────
# Root log level. Every app logger inherits it; django.db.backends is pinned at WARNING separately
# so DEBUG here does not start printing every SQL statement — which in a ledger means printing
# amounts and account ids into the log.
# LOG_LEVEL=INFO

# Where collectstatic writes. Needed for the admin to have CSS in production.
# STATIC_ROOT=/absolute/path/to/staticfiles

# Seconds to keep a Postgres connection open for reuse. 0 restores the old open-per-request cost.
# CONN_MAX_AGE=60
# DB_SSLMODE=require

# Celery task time limits, in seconds. Soft fires first so a task can log before the hard kill.
# CELERY_TASK_SOFT_TIME_LIMIT=300
# CELERY_TASK_TIME_LIMIT=360

# How often Beat advances the simulated market, in seconds (ADR-0017). This scales the GBM step, so
# it changes the clock each instrument's annualized drift and volatility are measured against — not
# just how many rows accumulate. Drop it to 5 for a demo where prices visibly move.
# MARKET_TICK_SECONDS=60

# Where prices come from. Point this at any class implementing markets.pricing.PriceSource to swap
# in a live market-data feed; markets.pricing.FixedPriceSource freezes the market for a demo.
# PRICE_SOURCE=markets.pricing.GBMPriceSource

# Where generated statement PDFs are written (ADR-0021). Never served directly — MEDIA_URL is not
# routed, and the only path to a file is the owner-scoped download endpoint.
# MEDIA_ROOT=/absolute/path/to/media

# WebSocket protocol limits (ADR-0022). How long an accepted socket may stay anonymous before it is
# closed, and how many price symbols one socket may subscribe to.
# WS_AUTH_DEADLINE_SECONDS=5
# WS_MAX_SUBSCRIPTIONS=25
