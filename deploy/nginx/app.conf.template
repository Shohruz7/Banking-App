## The server block. `${DOMAIN}` is substituted by the nginx image's entrypoint at container start.
##
## One origin serves everything: the bundle, /api, /ws and /static. That is not a deployment
## preference — the client hardcodes `BASE = "/api/v1"` and derives its socket URL from
## `window.location.host` (ADR-0030), so there is no configuration that would let it talk to a
## different host. The upside is that no CORS layer exists anywhere in this system.
##
## TLS is not configured here. Certbot writes a second server block into conf.d/ on the host and
## this one keeps serving the ACME challenge; see deploy/README.md. That keeps the image identical
## between the CI stack, a laptop and the box, which is the point of building it once.

server {
    listen 80;
    server_name ${DOMAIN};

    root /usr/share/nginx/html;
    index index.html;

    # --- the proxy contract, shared by every proxied location below ------------------------------

    # Included rather than written here, and included again inside every location that proxies.
    # `proxy_set_header` does not inherit into a block that declares any of its own, and all four
    # proxied locations below declare one — so this line alone reaches none of them. See the file.
    include /etc/nginx/proxy-headers.conf;
    proxy_redirect off;

    # --- failing over between the two app replicas (ADR-0043) -------------------------------
    #
    # A replica being recreated is briefly a routable address with nothing listening, so a connect
    # can hang rather than be refused. The default here is 60s, which would turn a one-second
    # container swap into a minute of stalled requests before nginx tried the other peer.
    proxy_connect_timeout 2s;
    # `error timeout` is nginx's default and is restated here because it is now a decision.
    #
    # **`non_idempotent` is deliberately absent.** A refused connection fails *before* the request
    # body is written, and nginx replays those to the next peer whatever the method — the
    # `non_idempotent` restriction only governs requests already sent. Adding it would make a POST
    # replayable after its body was sent, and `idempotency_key` on /api/v1/transfers/ is
    # `required=False` (ledger/serializers.py), so a keyless transfer would post twice. That is a
    # ledger corruption bug with a 100% reproduction, traded for nothing.
    #
    # `http_502 http_503 http_504` are absent for a different reason: ReadinessView returns a real
    # 503 when Postgres is down, and retrying that on the other replica would just double the load
    # during a database incident.
    proxy_next_upstream error timeout;
    proxy_next_upstream_tries 2;

    # --- security headers ------------------------------------------------------------------------
    #
    # An include, not inline directives, and the reason is an nginx rule that removes headers
    # without saying so: `add_header` is inherited by a nested block only when that block declares
    # none of its own. `location = /index.html` sets Cache-Control, so it was silently serving the
    # app's HTML with no CSP while every other path showed one. See security-headers.conf.

    include /etc/nginx/security-headers.conf;

    # --- probes and ACME -------------------------------------------------------------------------

    # Certbot's webroot challenge. Must stay reachable over plain HTTP even once a redirect to
    # https is in place on the host, or renewal fails against a 301.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Answered by nginx itself. A liveness probe that proxied to Django could not distinguish
    # "nginx is down" from "Django is down", which is the one distinction it exists to make.
    location = /healthz {
        access_log off;
        add_header Content-Type application/json always;
        include /etc/nginx/security-headers.conf;
        return 200 '{"status":"ok"}';
    }

    # --- the API ---------------------------------------------------------------------------------

    location /api/ {
        proxy_pass http://app;
        include /etc/nginx/proxy-headers.conf;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;

        # A dead app container is nginx's HTML error page by default, and the client's `apiFetch`
        # reads `response.json()` — so an outage arrived as a parse failure rather than as an error
        # the UI could describe. ADR-0006 says the API has exactly one error envelope; that has to
        # stay true when the thing answering is not the API.
        proxy_intercept_errors on;
        error_page 502 503 504 = @api_unavailable;
    }

    location /ws/ {
        proxy_pass http://app;
        include /etc/nginx/proxy-headers.conf;
        # The three lines that make an upgrade work. HTTP/1.1 because 1.0 has no Upgrade, and the
        # Connection header must be literally "upgrade" — not the keepalive "" used for /api/.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # A socket is idle between price ticks by design. The default 60s would close a healthy
        # connection every minute, and the client would reconnect forever without ever being wrong.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Django admin, DRF's browsable API and Swagger assets, served by whitenoise inside the app
    # image (ADR-0035).
    location /static/ {
        proxy_pass http://app;
        include /etc/nginx/proxy-headers.conf;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # The weakest surface on the box: a password form with no second factor behind it. The API's
    # TOTP guards /api/v1/auth/, not this — Django admin is session auth, so a stolen superuser
    # password is the entire control. Allowlisted by default; widen it while demoing.
    location /admin/ {
        include /etc/nginx/admin-allowlist.conf;
        proxy_pass http://app;
        include /etc/nginx/proxy-headers.conf;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    location @api_unavailable {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/security-headers.conf;
        # The ADR-0006 envelope, byte for byte, so a client that only knows how to read
        # `body.error.code` keeps working when the backend is the thing that is down.
        return 503 '{"error":{"code":"service_unavailable","message":"The service is temporarily unavailable. Please try again shortly.","details":{}}}';
    }

    # --- the bundle ------------------------------------------------------------------------------

    # Vite emits content-hashed filenames, so an asset URL is immutable by construction: change the
    # bytes and the name changes. `immutable` tells the browser not to bother revalidating.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        include /etc/nginx/security-headers.conf;
        try_files $uri =404;
    }

    # The one file that must never be cached. It is the map from route to chunk name, so a stale
    # copy points at chunks the current release does not serve — exactly the white screen the
    # client's error boundary reloads to escape. Cache it and that reload is useless, because the
    # reload fetches the same stale map.
    location = /index.html {
        add_header Cache-Control "no-store" always;
        include /etc/nginx/security-headers.conf;
    }

    # The SPA fallback, and the single most common way a React Router deploy is broken: without it,
    # loading /portfolio directly — or refreshing on it — is a 404 from nginx, because there is no
    # such file. The router only ever sees a URL the server already agreed to serve.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
