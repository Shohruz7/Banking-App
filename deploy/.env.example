# The deploy's environment. Copy to `deploy/.env` and fill in; that file is gitignored and must
# never be committed: it holds the key that decrypts account numbers and TOTP secrets.
#
#     cp deploy/.env.example deploy/.env
#
# `backend/.env.example` is the *development* counterpart of this file and stays as it is. This one
# describes a container stack rather than a host process, and the differences are load-bearing:
# hostnames are compose service names, not localhost.

# ------------------------------------------------------------------------------------------------
# Images
# ------------------------------------------------------------------------------------------------

# The tag both images are pulled at. A git SHA in production, set by the deploy script, and never
# `latest`, because that makes a rollback indistinguishable from a rebuild (ADR-0033).
IMAGE_TAG=local
BACKEND_IMAGE=banking-backend
WEB_IMAGE=banking-web

# ------------------------------------------------------------------------------------------------
# Django
# ------------------------------------------------------------------------------------------------

DJANGO_SETTINGS_MODULE=config.settings.prod

# No default anywhere. `prod.py` refuses to boot without it.
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# `localhost` belongs here even in production, and it is not laziness: the app container's own
# healthcheck requests http://127.0.0.1:8000/api/v1/ready/, and Django rejects a Host header that
# is not on this list. The container publishes no ports, so nothing outside the compose network can
# use it.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,bank.example.com

# The SPA uses bearer tokens and does not need CSRF, but **Django admin login 403s without this**
# the moment it is behind a proxy, because the Origin header no longer matches the host Django
# thinks it is. Scheme included, no path.
CSRF_TRUSTED_ORIGINS=https://bank.example.com

# The domain nginx serves and puts in its CSP `connect-src`. Must match the certificate.
DOMAIN=bank.example.com

# ------------------------------------------------------------------------------------------------
# Data
# ------------------------------------------------------------------------------------------------

POSTGRES_USER=banking
POSTGRES_PASSWORD=
POSTGRES_DB=banking
DATABASE_URL=postgres://banking:CHANGE_ME@postgres:5432/banking

# **`disable`, deliberately, and this is the setting most likely to be misread as a downgrade.**
# `prod.py` defaults to `require` because in any real deployment the database is on another host and
# everything crossing that wire is balances and PII. Here it is a container on this host's private
# bridge network, with no published port, speaking to another container, so the traffic never
# reaches a NIC. `postgres:16-alpine` ships no certificate, so `require` simply fails to connect.
#
# The setting exists precisely so that moving to managed RDS later is this variable rather than a
# code change. Set it back to `require` the day the database leaves this box.
DB_SSLMODE=disable

REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CHANNEL_LAYER_URL=redis://redis:6379/2

# --- the connection pool ---------------------------------------------------------------------
#
# Bounded, and the bound is the point. Django's ASGI handler runs each sync view in its own thread
# and a connection is thread-local, so the number of connections tracks requests *in flight* rather
# than worker count. Without this, a load test opened 100 connections against Postgres' default
# `max_connections` of 100 and 5.35% of requests failed with "sorry, too many clients already".
# With it, peak occupancy was 26 and p95 more than halved.
#
# `max_size` x replicas x (1 for the pool + Celery's own) must stay under Postgres'
# `max_connections`. At 20 that is two replicas plus a worker and beat, comfortably inside 100.
DB_POOL=true
DB_POOL_MIN=2
DB_POOL_MAX=20
# Seconds a request waits for a free connection before giving up. Short on purpose: a request
# queueing on the pool is already a request the client is waiting on, and failing fast is what
# makes the saturation visible instead of turning it into unbounded latency.
DB_POOL_TIMEOUT=10
# Only read when DB_POOL=false, and the two are mutually exclusive: psycopg's pool lives in
# DATABASES OPTIONS and Django refuses to combine it with persistent connections.
# CONN_MAX_AGE=60

# ------------------------------------------------------------------------------------------------
# Encryption (ADR-0027)
# ------------------------------------------------------------------------------------------------

# `label:urlsafe-base64-32-bytes`, newest first, comma-separated. The first entry encrypts new
# writes; every entry can still decrypt what it wrote, which is what makes rotation "prepend a key,
# deploy, re-save, drop the old one" rather than a flag day.
#
#     python -c "import base64, os; print('k2:' + base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# `prod.py` raises ImproperlyConfigured if this is empty. Losing it means losing every account
# number and TOTP secret in the database. Back it up somewhere that is not this box.
FIELD_ENCRYPTION_KEYS=

# ------------------------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------------------------

# What a newly registered customer is credited with. `seed_demo` passes its own per-user amount and
# ignores this.
ONBOARDING_OPENING_DEPOSIT=1000.0000

# Seconds between synthetic price ticks (ADR-0017).
MARKET_TICK_SECONDS=60

# How long machine-generated market data is kept (ADR-0041). 400 days rather than 90: statement
# regeneration reads period-end prices, and purging inside a plausible regeneration window would
# make a regenerated statement disagree with the stored PDF.
PRICE_TICK_RETENTION_DAYS=400

LOG_LEVEL=INFO

# The port nginx publishes. 80 in production, where certbot terminates TLS in a host-side server
# block; the CI overlay uses this to avoid needing root.
HTTP_PORT=80

# ------------------------------------------------------------------------------------------------
# Backups
# ------------------------------------------------------------------------------------------------
#
# **`backup.sh` runs with or without any of these, and that is exactly the problem they document.**
# Both failure modes are a warning on stderr and exit 0, so a nightly cron writing to a log nobody
# reads will report success while doing neither of the two things that make a backup a backup.
#
#     (crontab -l 2>/dev/null; echo '0 3 * * * /srv/banking/deploy/backup.sh >> /var/log/banking-backup.log 2>&1') | crontab -

# Where dumps land before they are shipped. The default needs root; anywhere the deploy user can
# write is fine, as long as it is on a disk with room for `BACKUP_RETAIN_DAYS` of them.
BACKUP_DIR=/var/backups/banking

# How long local copies are kept. The off-box copies are governed by the bucket's lifecycle policy,
# not by this.
BACKUP_RETAIN_DAYS=14

# **Unset means the dump is written in plaintext**, and a `pg_dump` of this database contains every
# account number and TOTP secret in the system. They are encrypted at rest in the column (ADR-0027),
# but the key that decrypts them lives in this very file, on the machine being dumped, so a dump has
# to be treated as though it were already decrypted.
#
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Store it somewhere that is not this box and is not the bucket. A passphrase kept beside the
# ciphertext is not a passphrase, and one kept nowhere means the backup is a file you cannot read.
BACKUP_PASSPHRASE=

# **Unset means the backup never leaves the machine it exists to survive the loss of.** This is the
# variable ADR-0039 leans on: keeping statement PDFs on a local volume rather than in S3 is only
# defensible because this ships them nightly. Without it, "we chose FileSystemStorage" means "we
# chose one disk".
#
# Any S3-compatible endpoint. `bootstrap.sh` installs the AWS CLI; credentials come from an instance
# role, or from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY below.
BACKUP_S3_URI=s3://your-bucket/banking

# Only needed when the box has no instance role. An IAM user scoped to `s3:PutObject` on that
# prefix and nothing else: this credential's whole job is to write files it can never read back.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# For an S3-compatible service that is not S3, including the MinIO the drill in deploy/README.md
# uses. The AWS CLI reads this natively from v2.13, so `backup.sh` needs no flag for it.
# AWS_ENDPOINT_URL=http://minio:9000
