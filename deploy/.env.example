# The deploy's environment. Copy to `deploy/.env` and fill in; that file is gitignored and must
# never be committed — it holds the key that decrypts account numbers and TOTP secrets.
#
#     cp deploy/.env.example deploy/.env
#
# `backend/.env.example` is the *development* counterpart of this file and stays as it is. This one
# describes a container stack rather than a host process, and the differences are load-bearing:
# hostnames are compose service names, not localhost.

# ------------------------------------------------------------------------------------------------
# Images
# ------------------------------------------------------------------------------------------------

# The tag both images are pulled at. A git SHA in production, set by the deploy script — never
# `latest`, because that makes a rollback indistinguishable from a rebuild (ADR-0033).
IMAGE_TAG=local
BACKEND_IMAGE=banking-backend
WEB_IMAGE=banking-web

# ------------------------------------------------------------------------------------------------
# Django
# ------------------------------------------------------------------------------------------------

DJANGO_SETTINGS_MODULE=config.settings.prod

# No default anywhere. `prod.py` refuses to boot without it.
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# `localhost` belongs here even in production, and it is not laziness: the app container's own
# healthcheck requests http://127.0.0.1:8000/api/v1/ready/, and Django rejects a Host header that
# is not on this list. The container publishes no ports, so nothing outside the compose network can
# use it.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,bank.example.com

# The SPA uses bearer tokens and does not need CSRF — but **Django admin login 403s without this**
# the moment it is behind a proxy, because the Origin header no longer matches the host Django
# thinks it is. Scheme included, no path.
CSRF_TRUSTED_ORIGINS=https://bank.example.com

# The domain nginx serves and puts in its CSP `connect-src`. Must match the certificate.
DOMAIN=bank.example.com

# ------------------------------------------------------------------------------------------------
# Data
# ------------------------------------------------------------------------------------------------

POSTGRES_USER=banking
POSTGRES_PASSWORD=
POSTGRES_DB=banking
DATABASE_URL=postgres://banking:CHANGE_ME@postgres:5432/banking

# **`disable`, deliberately, and this is the setting most likely to be misread as a downgrade.**
# `prod.py` defaults to `require` because in any real deployment the database is on another host and
# everything crossing that wire is balances and PII. Here it is a container on this host's private
# bridge network, with no published port, speaking to another container — the traffic never reaches
# a NIC. `postgres:16-alpine` ships no certificate, so `require` simply fails to connect.
#
# The setting exists precisely so that moving to managed RDS later is this variable rather than a
# code change. Set it back to `require` the day the database leaves this box.
DB_SSLMODE=disable

REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CHANNEL_LAYER_URL=redis://redis:6379/2

# ------------------------------------------------------------------------------------------------
# Encryption (ADR-0027)
# ------------------------------------------------------------------------------------------------

# `label:urlsafe-base64-32-bytes`, newest first, comma-separated. The first entry encrypts new
# writes; every entry can still decrypt what it wrote, which is what makes rotation "prepend a key,
# deploy, re-save, drop the old one" rather than a flag day.
#
#     python -c "import base64, os; print('k2:' + base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# `prod.py` raises ImproperlyConfigured if this is empty. Losing it means losing every account
# number and TOTP secret in the database — back it up somewhere that is not this box.
FIELD_ENCRYPTION_KEYS=

# ------------------------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------------------------

# What a newly registered customer is credited with. `seed_demo` passes its own per-user amount and
# ignores this.
ONBOARDING_OPENING_DEPOSIT=1000.0000

# Seconds between synthetic price ticks (ADR-0017).
MARKET_TICK_SECONDS=60

# How long machine-generated market data is kept (ADR-0041). 400 days rather than 90: statement
# regeneration reads period-end prices, and purging inside a plausible regeneration window would
# make a regenerated statement disagree with the stored PDF.
PRICE_TICK_RETENTION_DAYS=400

LOG_LEVEL=INFO

# The port nginx publishes. 80 in production, where certbot terminates TLS in a host-side server
# block; the CI overlay uses this to avoid needing root.
HTTP_PORT=80
