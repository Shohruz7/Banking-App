# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Django
*.sqlite3
staticfiles/
media/

# Celery Beat's local schedule state — regenerated on every start (ADR-0019)
celerybeat-schedule*
celerybeat.pid

# Environment / secrets — never commit
.env
.env.*
!.env.example

# Node (frontend, Week 7+)
node_modules/
frontend/dist/

# Local design docs (kept out of the published repo)
docs/
# Weekly plans and build logs stay local too — working notes, not published artifacts.
# The design-document PDF stays tracked.
Documentation/*.md

# Editors & OS
.DS_Store
.idea/
.vscode/
*.swp
